# 3. ACTIVITY DIAGRAM ROLE PESERTA (USER)

Diagram ini memuat seluruh alur aktivitas **Peserta**, dimulai dari proses registrasi akun baru & verifikasi kode OTP email, login, mengunggah berkas penilaian per kriteria, memantau status pengajuan, melihat riwayat penilaian, memperbarui profil/kata sandi, hingga logout.

```mermaid
flowchart TD
    MulaiPeserta([Mulai]) --> A_RegOrLogin{Sudah memiliki akun?}

    subgraph Pengguna["👤 Peserta (User)"]
        %% Alur Registrasi
        A_RegOrLogin -- Belum punya akun --> A_BukaReg[Membuka formulir pendaftaran akun]
        A_BukaReg --> A_IsiReg[Mengisi username, nama lengkap, email, password, foto profil]
        A_IsiReg --> A_KlikDaftar[Menekan tombol Daftar]
        A_RegGagal[Menerima pesan kesalahan pengisian] --> A_IsiReg
        A_HalamanOTP[Melihat halaman verifikasi OTP]
        A_HalamanOTP --> A_BukaEmail[Membuka kotak masuk email dan menyalin kode OTP 6 digit]
        A_BukaEmail --> A_InputOTP[Memasukkan kode OTP pada formulir]
        A_InputOTP --> A_KlikVerif[Menekan tombol Verifikasi OTP]
        A_OTPGagal[Menerima pesan kode OTP salah/kedaluwarsa] --> A_InputOTP
        A_KirimUlangOTP[Menekan tautan Kirim Ulang OTP] --> A_HalamanOTP
        A_RegSukses[Menerima notifikasi email berhasil diverifikasi] --> A_BukaLogin

        %% Alur Login
        A_RegOrLogin -- Sudah punya akun --> A_BukaLogin[Membuka halaman login]
        A_BukaLogin --> A_IsiLogin[Memasukkan email dan kata sandi]
        A_IsiLogin --> A_KlikLogin[Menekan tombol Masuk]
        A_LoginGagal[Menerima pesan email/password salah] --> A_IsiLogin
        A_Dash[Masuk ke Dasbor Utama Peserta]

        A_Dash --> A_PilihMenu{Memilih menu aktivitas}

        %% Menu 1: Upload Berkas
        A_PilihMenu -- Unggah Berkas --> A_BukaUpload[Membuka menu Unggah Berkas Penilaian]
        A_AdaProses[Menerima pesan: Masih ada berkas yang sedang diproses] --> A_BukaStatus
        A_FormUpload[Melihat formulir unggah berkas dan daftar kriteria]
        A_FormUpload --> A_UnggahDok[Mengunggah dokumen bukti untuk setiap kriteria]
        A_UnggahDok --> A_KirimBerkas[Menekan tombol Kirim Pengajuan]
        A_UploadSukses[Melihat pesan berkas berhasil dikirim] --> A_BukaStatus

        %% Menu 2: Status Penilaian
        A_PilihMenu -- Status Penilaian --> A_BukaStatus[Membuka halaman Status Penilaian]
        A_BukaStatus --> A_LihatStatus[Melihat status pengajuan terkini]
        A_LihatStatus --> A_CekStatus{Status Pengajuan}
        A_CekStatus -- Sedang Diproses --> A_Status0[Melihat keterangan: Berkas dalam proses penilaian]
        A_CekStatus -- Ditempatkan --> A_Status1[Melihat hasil penempatan dan nilai akhir yang diperoleh]
        A_CekStatus -- Ditolak --> A_Status2[Melihat keterangan ditolak & dapat mengajukan ulang]

        %% Menu 3: Riwayat Penilaian
        A_PilihMenu -- Riwayat Penilaian --> A_BukaRiwayat[Membuka menu Riwayat Penilaian]
        A_BukaRiwayat --> A_LihatRiwayat[Melihat seluruh arsip pengajuan penilaian sebelumnya]

        %% Menu 4: Profil
        A_PilihMenu -- Kelola Profil --> A_BukaProfil[Membuka halaman profil]
        A_BukaProfil --> A_AksiProfil{Pilih aksi profil}
        A_AksiProfil -- Edit Profil --> A_EditProfil[Mengubah username, nama, foto profil]
        A_EditProfil --> A_SimpanProfil[Menekan tombol Simpan Profil]
        A_AksiProfil -- Ubah Password --> A_EditPass[Memasukkan password lama dan password baru]
        A_EditPass --> A_SimpanPass[Menekan tombol Simpan Password]
        A_ProfilSukses[Menerima notifikasi profil/password berhasil diperbarui] --> A_Dash

        %% Menu 5: Logout
        A_PilihMenu -- Keluar Sistem --> A_Logout[Menekan tombol Keluar]
        A_LogoutSelesai[Diarahkan kembali ke halaman login]
    end

    subgraph Aplikasi["🖥️ Aplikasi (Frontend / Controller)"]
        %% Registrasi
        B_RegValid[Menerima data pendaftaran & validasi input] --> B_RegCek{Valid?}
        B_RegCek -- Tidak --> B_RegErr[Menampilkan pesan kesalahan validasi] --> A_RegGagal
        B_RegCek -- Ya --> B_RegDb[Meneruskan ke backend untuk simpan & kirim OTP]
        B_TampilOTP[Menampilkan halaman verifikasi OTP] --> A_HalamanOTP
        
        B_VerifOTP[Menerima kode OTP] --> B_VerifCek[Meneruskan ke backend untuk pengecekan]
        B_OTPErr[Menampilkan pesan kode OTP tidak valid] --> A_OTPGagal
        B_OTPOk[Mengarahkan ke login dengan notifikasi sukses] --> A_RegSukses
        B_ResendOTP[Memproses kirim ulang kode OTP] --> B_TampilOTP

        %% Login
        B_LoginValid[Menerima kredensial & validasi format] --> B_LoginDb[Meneruskan ke backend]
        B_LoginErr[Menampilkan pesan email/kata sandi salah] --> A_LoginGagal
        B_LoginOk[Membuat sesi peserta & meregenerasi token] --> B_ArahDash[Menampilkan Dasbor Peserta] --> A_Dash

        %% Upload Berkas
        B_CekAktif[Memeriksa apakah ada pengajuan aktif]
        B_CekAktif -- Ada pengajuan aktif --> B_TolakUpload[Mengarahkan ke status penilaian] --> A_AdaProses
        B_CekAktif -- Tidak ada pengajuan aktif --> B_TampilForm[Menampilkan form upload & kriteria] --> A_FormUpload
        B_SimpanBerkas[Menerima berkas & simpan ke storage] --> B_SimpanPenilaianDb[Meneruskan transaksi ke basis data]
        B_UploadOk[Mengarahkan ke status penilaian] --> A_UploadSukses

        %% Status & Riwayat
        B_GetStatus[Mengambil data penilaian terbaru peserta] --> A_LihatStatus
        B_GetRiwayat[Mengambil riwayat seluruh penilaian peserta] --> A_LihatRiwayat

        %% Profil
        B_UpdateProfil[Menerima pembaruan data profil/password] --> B_UpdateProfilDb[Meneruskan ke basis data]
        B_ProfilOk[Menampilkan notifikasi berhasil] --> A_ProfilSukses

        %% Logout
        B_Logout[Menghapus sesi & token aktif] --> B_LogoutArah[Mengarahkan ke halaman login] --> A_LogoutSelesai
    end

    subgraph Backend["⚙️ Backend & Basis Data"]
        %% Database Registrasi & OTP
        C_DbStoreUser[(Menyimpan data user baru role=3)] --> C_GenOTP[Membuat OTP 6 digit & simpan ke database]
        C_GenOTP --> C_SendMail[["Mengirimkan Email OTP ke Peserta"]] --> B_TampilOTP
        C_DbVerifOTP[(Memeriksa kecocokan OTP & expired_at)] --> C_CekOTP{Sesuai?}
        C_CekOTP -- Tidak --> B_OTPErr
        C_CekOTP -- Ya --> C_DbVerifSukses[(Update email_verified_at = now dan hapus OTP)] --> B_OTPOk
        C_DbResend[(Memperbarui OTP baru dan kirim ulang email)] --> B_ResendOTP

        %% Database Login
        C_DbLogin[(Memeriksa email, password hash, dan email_verified_at)] --> C_CekLogin{Valid?}
        C_CekLogin -- Tidak --> B_LoginErr
        C_CekLogin -- Ya --> B_LoginOk

        %% Database Upload Berkas
        C_DbCekAktif[(Memeriksa pengajuan dengan flag_penilaian = 0)] --> B_CekAktif
        C_DbStorePenilaian[(Menyimpan record penilaians, detail_penilaians, dan dokumens)] --> B_UploadOk

        %% Database Status & Riwayat
        C_DbGetStatus[(Mengambil penilaian terkini + relasi detail dokumen & penempatan)] --> B_GetStatus
        C_DbGetRiwayat[(Mengambil seluruh riwayat penilaian milik user)] --> B_GetRiwayat

        %% Database Profil
        C_DbUpdateProfil[(Memperbarui data profil / hash password baru)] --> B_ProfilOk

        %% Database Logout
        C_DbLogout[(Menghapus sesi login)] --> B_LogoutArah
    end

    A_KlikDaftar --> B_RegValid
    B_RegDb --> C_DbStoreUser
    A_KlikVerif --> B_VerifOTP
    B_VerifCek --> C_DbVerifOTP
    A_KirimUlangOTP --> C_DbResend

    A_KlikLogin --> B_LoginValid
    B_LoginDb --> C_DbLogin

    A_BukaUpload --> C_DbCekAktif
    A_KirimBerkas --> B_SimpanBerkas
    B_SimpanPenilaianDb --> C_DbStorePenilaian

    A_BukaStatus --> C_DbGetStatus
    A_BukaRiwayat --> C_DbGetRiwayat

    A_SimpanProfil --> B_UpdateProfil
    A_SimpanPass --> B_UpdateProfil
    B_UpdateProfilDb --> C_DbUpdateProfil

    A_Logout --> B_Logout
    B_Logout --> C_DbLogout

    A_Status0 --> SelesaiPeserta([Selesai])
    A_Status1 --> SelesaiPeserta
    A_Status2 --> SelesaiPeserta
    A_LogoutSelesai --> SelesaiPeserta
```

